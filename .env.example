# ──────────────────────────────────────────────
# StayNest — Environment Configuration
# ──────────────────────────────────────────────
# In Vite, all client-exposed variables MUST be
# prefixed with VITE_  (https://vite.dev/guide/env-and-mode)

# ─── App ──────────────────────────────────────
VITE_APP_NAME=StayNest
VITE_APP_TAGLINE=Premium Hostels
VITE_APP_URL=http://localhost:5173

# ─── Contact Info ─────────────────────────────
VITE_CONTACT_EMAIL=support@staynest.com
VITE_CONTACT_PHONE=+91 123 456 7890
VITE_CONTACT_ADDRESS=Mumbai, Maharashtra, India

# ─── Social Links ─────────────────────────────
VITE_SOCIAL_FACEBOOK=https://facebook.com/staynest
VITE_SOCIAL_TWITTER=https://twitter.com/staynest
VITE_SOCIAL_INSTAGRAM=https://instagram.com/staynest

# ─── API (for future backend integration) ─────
# VITE_API_BASE_URL=http://localhost:3000/api
# VITE_API_TIMEOUT=10000

# ─── Payment Gateway (for future use) ─────────
# VITE_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx

# ─── Maps (for future use) ────────────────────
# VITE_GOOGLE_MAPS_API_KEY=your_google_maps_key
